   "metadata": {},
   "outputs": [],
   "source": [
    "from itertools import product"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "4c62ce8c",
   "metadata": {},
   "outputs": [],
   "source": [
    "params = {\n",
    "    \"learning_Rate\": [1e-1, 1e-2, 1e-3],\n",
    "    \"batch_size\": [16, 32, 64]\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "c8215ce2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(0.1, 16)\n",
      "(0.1, 32)\n",
      "(0.1, 64)\n",
      "(0.01, 16)\n",
      "(0.01, 32)\n",
      "(0.01, 64)\n",
      "(0.001, 16)\n",
      "(0.001, 32)\n",
      "(0.001, 64)\n"
     ]
    }
   ],
   "source": [
    "for combination in product(*params.values()):\n",
    "    print(combination)"
   ]
  }
